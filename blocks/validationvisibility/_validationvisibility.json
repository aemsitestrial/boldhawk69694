{
  "definitions": [
    {
      "title": "Validation Visibility",
      "id": "validationvisibility",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "ValidationVisibility",
              "model": "validationvisibility",
              "isDecorative": false,
              "enableCta": false
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "validationvisibility",
      "fields": [
        {
          "component": "reference",
          "name": "image",
          "label": "Image",
          "valueType": "string",
          "multi": false
        },
        {
          "component": "boolean",
          "name": "isDecorative",
          "label": "Decorative Image",
          "description": "Hide alt text when the selected image is decorative.",
          "valueType": "boolean"
        },
        {
          "component": "text",
          "name": "imageAlt",
          "label": "Alt Text",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "isDecorative"
              },
              false
            ]
          },
          "validation": {
            "minLength": 5,
            "maxLength": 120,
            "customErrorMsg": "Provide meaningful alt text between 5 and 120 characters, or mark the image as decorative."
          }
        },
        {
          "component": "boolean",
          "name": "enableCta",
          "label": "Enable CTA",
          "description": "Show or hide the CTA authoring fields.",
          "valueType": "boolean"
        },
        {
          "component": "aem-content",
          "name": "ctaLink",
          "label": "CTA Link",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "enableCta"
              },
              true
            ]
          },
          "validation": {
            "rootPath": "/content"
          }
        },
        {
          "component": "text",
          "name": "ctaLinkText",
          "label": "CTA Label",
          "valueType": "string",
          "condition": {
            "===": [
              {
                "var": "enableCta"
              },
              true
            ]
          },
          "validation": {
            "minLength": 2,
            "maxLength": 30,
            "customErrorMsg": "Use a CTA label between 2 and 30 characters."
          }
        }
      ]
    }
  ],
  "filters": []
}