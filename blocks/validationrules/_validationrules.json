{
  "definitions": [
    {
      "title": "Validation Rules",
      "id": "validationrules",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "ValidationRules",
              "model": "validationrules",
              "title": "Validation Rules",
              "titleType": "h2",
              "slug": "validation-rules",
              "priority": 1
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "validationrules",
      "fields": [
        {
          "component": "text",
          "name": "title",
          "label": "Title",
          "valueType": "string",
          "required": true,
          "validation": {
            "minLength": 5,
            "maxLength": 60,
            "customErrorMsg": "Enter a title between 5 and 60 characters."
          }
        },
        {
          "component": "select",
          "name": "titleType",
          "label": "Title Type",
          "valueType": "string",
          "options": [
            {
              "name": "Heading 2",
              "value": "h2"
            },
            {
              "name": "Heading 3",
              "value": "h3"
            },
            {
              "name": "Heading 4",
              "value": "h4"
            }
          ]
        },
        {
          "component": "text",
          "name": "slug",
          "label": "Slug",
          "valueType": "string",
          "required": true,
          "validation": {
            "regExp": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "customErrorMsg": "Use lowercase letters, numbers, and hyphens only."
          }
        },
        {
          "component": "text",
          "name": "contactEmail",
          "label": "Contact Email",
          "valueType": "string",
          "validation": {
            "regExp": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
            "customErrorMsg": "Enter a valid email address."
          }
        },
        {
          "component": "number",
          "name": "priority",
          "label": "Priority",
          "valueType": "number",
          "value": 1,
          "validation": {
            "numberMin": 1,
            "numberMax": 12,
            "customErrorMsg": "Enter a number between 1 and 12."
          }
        }
      ]
    }
  ],
  "filters": []
}